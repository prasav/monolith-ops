# monolith-ops Environment Variables
# Copy to .env and fill in values - NEVER commit .env

# ===========================================
# OCI (Oracle Cloud Infrastructure)
# ===========================================
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxx
OCI_USER_OCID=ocid1.user.oc1..xxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_PRIVATE_KEY_PATH=~/.oci/oci_api_key.pem
OCI_REGION=us-phoenix-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..xxxxx

# A1 Instance sizing (Always Free limits: max 2 OCPU, 12 GB as of June 2026)
A1_OCPUS=2
A1_MEMORY_GB=12
INSTANCE_HOSTNAME=monolith-a1

# Network
VCN_CIDR=10.0.0.0/16
VCN_DNS_LABEL=monolithvcn
SUBNET_CIDR=10.0.1.0/24
SUBNET_DNS_LABEL=monolithsub

# Admin access (your public IP/32)
ADMIN_CIDR=xxx.xxx.xxx.xxx/32

# SSH
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub

# Timezone
TIMEZONE=Asia/Kolkata
ENVIRONMENT=production

# ===========================================
# GCP (Google Cloud Platform)
# ===========================================
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Service account for Terraform (create separately, download JSON key)
# GOOGLE_CREDENTIALS=$(cat gcp-sa.json)
TF_SA_EMAIL=terraform@your-project-id.iam.gserviceaccount.com

# Admin SSH key for e2-micro
ADMIN_SSH_KEY=ssh-ed25519 AAAA... user@host

# Billing account for budget alerts
GCP_BILLING_ACCOUNT=XXXXXX-XXXXXX-XXXXXX

# GitHub for Cloud Build (optional, can use Cloud Source Repos instead)
GITHUB_OWNER=prasav
GITHUB_REPO=monolith-ops

# ===========================================
# Cloudflare
# ===========================================
CLOUDFLARE_API_TOKEN=your-api-token-with-zone-account-r2-workers-pages-access-perms
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ZONE_ID=your-zone-id
DOMAIN=yourdomain.com

# Tunnel tokens (generate after creating tunnels in Cloudflare dashboard)
ORACLE_TUNNEL_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
GCP_TUNNEL_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Zero Trust Access
ADMIN_EMAIL=you@yourdomain.com

# Email Routing
PERSONAL_EMAIL=yourpersonal@gmail.com

# ===========================================
# Application Secrets (generate with: openssl rand -base64 32)
# ===========================================
N8N_DB_PASSWORD=changeme
GITEA_DB_PASSWORD=changeme
GITEA_RUNNER_TOKEN=changeme
VAULTWARDEN_ADMIN_TOKEN=changeme

# Cloudflare R2
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tailscale
TAILSCALE_AUTH_KEY=tskey-xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub (for webhooks, optional)
GITHUB_WEBHOOK_SECRET=changeme
GITEA_TOKEN=changeme

# Backup
BACKUP_TOKEN=changeme